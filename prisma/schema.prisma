generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     Task[]
  auditLogs AuditLog[]
  attachments TaskAttachment[]
  payments  Payment[]
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId      Int
  user        User       @relation(fields: [userId], references: [id])
  attachments TaskAttachment[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  taskId    Int
  userId    Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model TaskAttachment {
  id           Int      @id @default(autoincrement())
  originalName String
  storedName   String
  mimeType     String
  size         Int
  path         String
  taskId       Int
  userId       Int
  createdAt    DateTime @default(now())

  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id])
}

model Payment {
  id                Int           @id @default(autoincrement())
  amount            Int
  currency          String        @default("usd")
  status            PaymentStatus @default(PENDING)

  provider          String
  providerPaymentId String        @unique

  userId            Int

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  user              User          @relation(fields: [userId], references: [id])
}

model WebhookEvent {
  id                Int      @id @default(autoincrement())
  provider          String
  providerEventId   String   @unique
  providerPaymentId String
  status            String
  createdAt         DateTime @default(now())
}